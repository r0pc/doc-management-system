# Secure Document Management System - example environment.
# Copy to .env and adjust. NEVER commit .env. All defaults below are dev-safe;
# change every credential before any non-local deployment.
#
# ENV=prod is gated at startup by app.config.validate_runtime, which refuses to
# boot while any dev-shaped setting is still in place. See "Production" below.

# --- Application (consumed by backend/app/config.py) ---
ENV=dev
DATABASE_URL=postgresql+psycopg://docmgmt_app:docmgmt@localhost:55432/docmgmt
REDIS_URL=redis://localhost:6379/0

# Storage: local (filesystem) or minio. Self-hosted only by design.
# STORAGE_BACKEND=local signs its own presigned URLs with an HMAC dev secret and
# exposes /v1/dev-storage; both are dev-only and refused under ENV=prod.
STORAGE_BACKEND=local
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_BUCKET_PREFIX=docs-

# Malware scanning is mandatory in prod; startup fails closed without it.
# CLAMAV_HOST is the compose service name. Running the integration suite from
# the HOST (outside compose) needs CLAMAV_HOST=localhost instead.
SCAN_ENABLED=false
CLAMAV_HOST=clamav

# Dev-only JWT shim secret. Must be non-empty under ENV=dev and empty under
# ENV=prod, where identity comes from OIDC/JWKS only (invariant #7).
DEV_JWT_SECRET=change-me-to-something-random
OIDC_ISSUER=
OIDC_AUDIENCE=

UPLOAD_MAX_BYTES=104857600
PRESIGN_TTL_SECONDS=90

# --- Infrastructure (consumed by docker-compose.yml interpolation) ---
POSTGRES_USER=docmgmt
POSTGRES_PASSWORD=docmgmt
POSTGRES_DB=docmgmt
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# --- Production ---------------------------------------------------------
# Every line below is enforced at startup. The process refuses to boot while
# any of them is unmet, and reports the full set in one error rather than one
# restart at a time.
#
#   ENV=prod
#   SCAN_ENABLED=true              # malware scanning is fail-closed
#   STORAGE_BACKEND=minio          # never local
#   MINIO_SECURE=true              # object traffic must be TLS
#   MINIO_SECRET_KEY=<generated>   # not the compose default
#   OIDC_ISSUER=https://<idp>/realms/<realm>
#   OIDC_AUDIENCE=docmgmt-api
#   DEV_JWT_SECRET=                # must be empty; the HS256 shim is forbidden
#   CORS_ORIGINS=https://<your-frontend-host>    # no loopback origins
#
# Also rotate, outside this file: POSTGRES_PASSWORD, the docmgmt_app role
# password, and MINIO_ROOT_USER / MINIO_ROOT_PASSWORD.
