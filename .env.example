# Secure Document Management System - example environment.
# Copy to .env and adjust. NEVER commit .env. All defaults below are dev-safe;
# change every credential before any non-local deployment.

# --- Application (consumed by backend/app/config.py) ---
ENV=dev
DATABASE_URL=postgresql+psycopg://docmgmt:docmgmt@localhost:55432/docmgmt
REDIS_URL=redis://localhost:6379/0

# Storage: local (filesystem) or minio. Self-hosted only by design.
STORAGE_BACKEND=local
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_BUCKET_PREFIX=docs-

# Malware scanning is mandatory in prod; startup fails closed without it.
SCAN_ENABLED=false

# Dev-only JWT shim secret. Replace with Keycloak/OIDC in later waves.
DEV_JWT_SECRET=dev-only-secret-change-me
OIDC_ISSU=
OIDC_AUDIENCE=

UPLOAD_MAX_BYTES=104857600
PRESIGN_TTL_SECONDS=90

# --- Infrastructure (consumed by docker-compose.yml interpolation) ---
POSTGRES_USER=docmgmt
POSTGRES_PASSWORD=docmgmt
POSTGRES_DB=docmgmt
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
